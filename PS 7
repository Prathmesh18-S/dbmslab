CREATE OR REPLACE TRIGGER Library_Audit_Trigger
BEFORE UPDATE OR DELETE ON Library
FOR EACH ROW
BEGIN
    IF UPDATING THEN
        INSERT INTO Library_Audit
        VALUES (
            :OLD.book_id,
            :OLD.book_name,
            :OLD.author,
            :OLD.category,
            :OLD.book_date,
            'UPDATE'
        );
    ELSIF DELETING THEN
        INSERT INTO Library_Audit
        VALUES (
            :OLD.book_id,
            :OLD.book_name,
            :OLD.author,
            :OLD.category,
            :OLD.book_date,
            'DELETE'
        );
    END IF;
END;
